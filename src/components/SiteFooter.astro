---
import { siteConfig } from '../config/site';

const { showCta = true } = Astro.props;
const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer class="shared-footer">
	<div class:list={['shared-footer-inner', !showCta && 'shared-footer-inner-no-cta']}>
		{
			showCta && (
				<div class="shared-footer-cta">
					<h2>¿Trabajamos juntos?</h2>
					<p>
		Si mi perfil encaja con lo que estás buscando, podés{' '}
		<a
			class="shared-footer-inline-link"
			href={`${base}/files/eliana-becerra-cv.pdf`}
			download
		>
			descargar mi CV
		</a>
		{' '}o contactarme directamente.
	</p>
					<a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
				</div>
			)
		}

		<div class="shared-footer-meta">
			<div class="shared-footer-links">
				{
					siteConfig.socialLinks.map((link) => (
						<a href={link.href} target="_blank" rel="noopener noreferrer">
							{link.label}
						</a>
					))
				}
			</div>
			<div class="shared-footer-note">
				
				<p>&copy; {currentYear} {siteConfig.name}.</p>
			</div>
		</div>
	</div>
</footer>
